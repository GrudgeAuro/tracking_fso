#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(r16ui, binding = 0) readonly uniform uimage2D inImage;
layout(r16ui, binding = 1) writeonly uniform uimage2D outImage;

layout(push_constant) uniform Params
{
    uint width;
    uint height;
    uint strideBytes;
    uint planeOffsetBytes;
} p;

uint samplePixel(int x, int y)
{
    x = clamp(x, 0, int(p.width) - 1);
    y = clamp(y, 0, int(p.height) - 1);
    return imageLoad(inImage, ivec2(x, y)).r;
}

uint median9(uint a[9])
{
    for (int i = 1; i < 9; ++i)
    {
        uint key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key)
        {
            a[j + 1] = a[j];
            --j;
        }
        a[j + 1] = key;
    }
    return a[4];
}

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= p.width || y >= p.height)
        return;

    uint v[9];
    int k = 0;
    for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx)
            v[k++] = samplePixel(int(x) + dx, int(y) + dy);

    imageStore(outImage, ivec2(x, y), uvec4(median9(v), 0u, 0u, 0u));
}
